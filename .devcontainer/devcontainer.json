{
  "name": "Crypto Taxes Dev Container",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  
  // Features to add to the dev container
  "features": {},

  // VS Code extensions to install
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-python.isort",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.extraPaths": ["/workspace/backend", "/home/app/.local/lib/python3.11/site-packages"],
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false,
        "python.formatting.provider": "black",
        "python.analysis.typeCheckingMode": "basic",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": true
        },
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true
        },
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[javascriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  },

  // Forward ports for development
  "forwardPorts": [5000, 3000, 5432],
  "portsAttributes": {
    "5000": {
      "label": "Backend API",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Frontend",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },

  // Post-create commands to run after container creation
  // Install additional dev dependencies (main packages already installed during Docker build)
  // Also configure git to allow operations in the workspace directory
  "postCreateCommand": "pip install --user pytest-cov black isort",
  "postStartCommand": "git config --global --add safe.directory /workspace",

  // Use 'forwardPorts' instead of 'appPort' for docker-compose
  "remoteUser": "app",

  // Remote environment variables
  "remoteEnv": {
    "DATABASE_URL": "postgresql+psycopg2://cryptotaxes:cryptotaxes@postgres:5432/cryptotaxes",
    "PYTHONPATH": "/workspace/backend",
    "FLASK_APP": "app.py",
    "FLASK_ENV": "development"
  }
}
